# ============================================================
# 安全警告：
# 1. 复制此文件为 .env 并填入真实密钥
# 2. .env 文件绝不能提交到 Git 或分享给他人
# 3. JWT_SECRET 必须设置为随机字符串（建议 32 位以上）
# 4. 生产环境必须设置所有环境变量，否则应用将拒绝启动
# ============================================================

PORT=3002
NODE_ENV=development

# JWT 签名密钥（必填，生产环境必须设置）
JWT_SECRET=

# DashScope API Key（通义千问）
DASHSCOPE_API_KEY=
AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_MODEL=qwen3.6-flash

# DeepSeek API Key
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# CORS 白名单（生产环境按需设置，逗号分隔）
CORS_ORIGIN=

# 数据库迁移时创建管理员账号的初始密码（仅首次运行需要）
ADMIN_INIT_PASSWORD=
